{% use '@Contao/kiss_attributes/_card_attributes.html.twig' %}
{% use '@Contao/kiss_component/status/_alert.html.twig' %}
{% use '@Contao/kiss_component/status/_badge.html.twig' %}
{% extends '@Contao/content_element/_base.html.twig' %}

{% set card_attributes = attrs(card_attributes|default).addClass(['card-primary', 'mt-16', 'mb-8']) %}
{% set alert_attributes = attrs(alert_attributes|default).addClass(['mt-12', 'mb-6']) %}
{% set badge_attributes = attrs(badge_attributes|default).addClass('mb-2') %}

{% block alert_title %}
    {% if kissStatus|default %}
        {% with {item: {
            text: ('rsce.field.kissStatus.options.' ~ kissStatus)|trans({}, 'rsce'),
            color: {extended: 'success', styled: 'warning', core: 'error'}[kissStatus]|default,
        }} %}
            {{ block('badge') }}
        {% endwith %}
    {% endif %}
    {{ parent() }}
{% endblock %}

{% block content %}
    {% if documentationLevel|default == 'subsection' %}
        {% with {color: 'primary', variant: 'soft'} %}
            {{ block('alert') }}
        {% endwith %}
    {% else %}
        <div{{ block('card_attributes') }}>
            <div class="card-body">
                <hgroup>
                    {% if topline|default %}
                        <p class="topline fixed-body-sm opacity-60 m-0">{{ topline|insert_tag }}</p>
                    {% endif %}
                    <h2 class="card-title m-0">{{ title|default|insert_tag }}</h2>
                </hgroup>
                {% if text|default %}
                    <div class="rte"><p>{{ text|sanitize_html('contao')|insert_tag_raw }}</p></div>
                {% endif %}
                {% if links|default %}
                    <ol class="showcase-nav-cards showcase-section-links mt-6">
                        {% for link in links %}
                            <li>
                                <a{{ attrs()
                                    .addClass(['card', 'card-sm', 'card-soft', 'card-grow'])
                                    .set('href', link.url|default|insert_tag|encode_email)
                                    .set('target', '_blank', link.target|default)
                                    .set('rel', 'noreferrer noopener', link.target|default)
                                }}>
                                    <div class="card-body">
                                        <span{{ attrs()
                                            .addClass(['showcase-nav-icon', 'showcase-icon-' ~ link.showcaseIcon|default('placeholder')])
                                            .set('aria-hidden', 'true')
                                        }}></span>
                                        {{ link.linkTitle|default(link.url)|insert_tag }}
                                    </div>
                                </a>
                            </li>
                        {% endfor %}
                    </ol>
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endblock %}
