/* Showcase navigation cards (html content elements on the showcase pages/Documentation) */

.showcase-nav-cards {
    @apply grid grid-cols-2 gap-4 p-0 m-0 list-none sm:grid-cols-3 lg:grid-cols-4;

    > li {
        @apply m-0;
    }

    a {
        @apply h-full no-underline;
    }

    strong {
        @apply fixed-title-sm;
    }

    code {
        @apply fixed-label-xs text-neutral-on-light wrap-anywhere;
    }
}

/* Contao's html sanitizer strips inline <svg>, so the icons are masks */
.showcase-nav-icon {
    @apply block w-14 aspect-[4/3] mb-1 bg-primary-solid mask-no-repeat mask-center mask-contain;
}

.section-headline .showcase-nav-icon {
    @apply inline-block w-[1.5em] mb-0 mr-3 align-[-0.15em];
}

.showcase-icon-hero {
    mask-image: url("./assets/showcase/hero.svg");
}

