/* Component showcase (kiss/showcase templates) */

@layer components {
    /* The top padding clears the absolutely positioned default header */
    .showcase-hero {
        @apply pt-32 pb-16 md:pt-48 md:pb-24 bg-neutral-surface-2;

        p {
            @apply max-w-prose responsive-body-lg text-neutral-on-light;
        }
    }

    .showcase-section {
        > h2 {
            @apply pb-3 border-b border-neutral-border-light;
        }

        > h3 {
            @apply mt-14 mb-2 md:mb-3;
        }

        > h4 {
            @apply mt-8 mb-2 md:mb-3;
        }

        > p {
            @apply max-w-prose fixed-body-md text-neutral-on-light;
        }

        > :is(h3, h4) + p {
            @apply mt-0 mb-4;
        }
    }

    /* API overview */
    .showcase-api {
        @apply grid gap-x-6 gap-y-2 p-6 m-0 rounded-lg bg-neutral-surface-2 fixed-body-md sm:grid-cols-[8rem_1fr];

        dt {
            @apply font-semibold;
        }

        dd {
            @apply m-0;
        }
    }

    /* Demo stage: a row of examples, each a <figure> with a class caption */
    .showcase-demo {
        @apply flex flex-wrap items-end gap-6 p-6 mb-6 rounded-lg border border-neutral-border-light;

        > figure {
            @apply flex flex-col items-center gap-2 m-0;
        }
    }

    .showcase-demo-stack {
        @apply flex-col items-stretch;

        > figure {
            @apply items-stretch;
        }
    }

    .showcase-demo-grid {
        @apply grid gap-6 items-start sm:grid-cols-2 lg:grid-cols-3;

        > figure {
            @apply items-stretch;
        }
    }

    .showcase-demo figcaption,
    .showcase-caption {
        @apply fixed-label-xs text-neutral-on-light;
    }

    /* Style x color matrix */
    .showcase-matrix {
        @apply mb-6 overflow-x-auto rounded-lg border border-neutral-border-light;

        table {
            @apply w-full m-0 border-collapse;
        }

        :is(th, td) {
            @apply px-4 py-3 text-center align-middle;

            &:first-child {
                @apply text-left whitespace-nowrap;
            }
        }

        thead th {
            @apply fixed-label-sm bg-neutral-surface-2;
        }

        tbody tr + tr {
            @apply border-t border-neutral-border-light;
        }

        tbody th {
            @apply fixed-label-sm font-normal;

            code {
                @apply block fixed-label-xs text-neutral-on-light;
            }
        }
    }

    /* Code sample */
    .showcase-code {
        @apply p-4 mb-6 overflow-x-auto rounded-lg bg-neutral-surface-2 fixed-label-xs whitespace-pre;

        font-family: var(--font-mono);
    }

    /* Icons from layout/kiss_icons are 32px, the components do not size them */
    .showcase-demo .svg-icon {
        @apply size-[1.25em] shrink-0;
    }
}
